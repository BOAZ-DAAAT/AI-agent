LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=adv_daaat.

# MySQL access
MYSQL_HOST=localhost
MYSQL_USERNAME=root
MYSQL_DATABASE=olist
MYSQL_PORT=3306
MYSQL_PASSWORD=

# Pinecone integrated-embedding index for company context retrieval
PINECONE_API_KEY=
PINECONE_INDEX_NAME=olist
PINECONE_NAMESPACE=olist-rag-v1
PINECONE_TEXT_FIELD=text
PINECONE_TOP_K=5
PINECONE_TIMEOUT_SECONDS=10
PINECONE_RERANK_ENABLED=true
PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# GE(정합성 검사)가 쓰는 별도 변수명 — 보통 위 MYSQL_*와 같은 로컬 MySQL을 가리키면 됨.
# 없으면 GE 실행 시 "Access denied" 에러가 남 (STORAGE_MYSQL_PASSWORD 기본값이 빈 문자열이라서).
STORAGE_MYSQL_HOST=localhost
STORAGE_MYSQL_USER=root
STORAGE_MYSQL_PORT=3306
STORAGE_MYSQL_PASSWORD=

# 1이면 개발용 샘플 DB(olist_sampling)와 샘플용 정합성 결과를 자동으로 사용한다.
# 0이거나 지우면 원본(olist)을 사용한다. scripts/sampling/README.md 참고.
USE_SAMPLING_DB=0

# false이면 Olist 고정 SQL 템플릿을 건너뛰고 semantic planning 경로만 사용한다.
OLIST_TEMPLATE_ROUTING_ENABLED=true

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/e-jungs2/BOAZ_adv
OPENROUTER_APP_TITLE=e_jungs2

# Main text model
# EDA / analysis planner / normal text reasoning
LLM_MODEL=google/gemini-2.5-flash

# Chart multimodal reader
# Model must support image input -> text output.
CHART_READER_MODEL=openai/gpt-5
CODE_GENERATOR_MODEL=openai/gpt-5
ANALYSIS_CRITIC_MODEL=openai/gpt-5
ANALYSIS_CODE_EXEC_TIMEOUT_SECONDS=600

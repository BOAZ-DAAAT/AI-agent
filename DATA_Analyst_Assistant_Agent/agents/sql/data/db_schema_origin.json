    "orders": {
        "primary_key": [],
        "description": "이 테이블은 고객의 주문 생성부터 승인, 출고, 최종 배송, 그리고 예상 배송일까지의 주문 처리 이력을 관리하는 주문 헤더(주문 요약) 테이블입니다.",
        "columns": [
            {
                "name": "order_id",
                "type": "VARCHAR(50)",
                "nullable": true,
                "description": "각 주문을 고유하게 식별하는 주문 ID로, 주문 1건마다 하나씩 부여되는 기본 키 역할의 값입니다."
            },
            {
                "name": "customer_id",
                "type": "VARCHAR(50)",
                "nullable": true,
                "description": "주문을 한 고객을 식별하는 고객 ID로, 한 고객이 여러 주문을 가질 수 있습니다."
            },
            {
                "name": "order_status",
                "type": "VARCHAR(20)",
                "nullable": true,
                "description": "주문의 현재 처리 상태를 나타내는 값입니다. 샘플에서는 delivered(배송 완료), shipped(출고됨) 등이 보이며 주문 진행 단계를 구분하는 데 사용됩니다."
            },
            {
                "name": "order_purchase_timestamp",
                "type": "DATETIME",
                "nullable": true,
                "description": "고객이 실제로 주문을 생성한 시점입니다. 주문 접수 시각을 의미하며 주문 흐름의 시작점입니다."
            },
            {
                "name": "order_approved_at",
                "type": "DATETIME",
                "nullable": true,
                "description": "주문이 결제/승인 처리된 시각입니다. 구매 후 내부 검토나 결제 승인 완료 시점을 기록합니다."
            },
            {
                "name": "order_delivered_carrier_date",
                "type": "DATETIME",
                "nullable": true,
                "description": "판매자 또는 물류센터에서 택배사/운송사로 상품이 인계되어 출고된 시각입니다. 즉, 배송 운송이 시작된 시점입니다."
            },
            {
                "name": "order_delivered_customer_date",
                "type": "DATETIME",
                "nullable": true,
                "description": "상품이 최종 고객에게 실제로 배송 완료된 시각입니다. delivered 상태일 때 주로 값이 존재하고, 아직 배송 완료 전이면 NaT처럼 비어 있을 수 있습니다."
            },
            {
                "name": "order_estimated_delivery_date",
                "type": "DATETIME",
                "nullable": true,
                "description": "시스템이 예상한 주문 배송 완료 예정일입니다. 실제 배송일과 비교하여 배송 지연 여부를 판단하는 기준으로 활용됩니다."
            }
        ],

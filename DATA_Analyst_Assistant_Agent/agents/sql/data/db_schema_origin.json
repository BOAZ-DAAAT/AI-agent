    "order_items": {
        "primary_key": [],
        "description": "주문별 상품 단위의 상세 내역을 저장하는 테이블로, 한 주문에 포함된 각 상품의 판매자, 가격, 배송 제한일, 배송비 정보를 관리한다.",
        "columns": [
            {
                "name": "order_id",
                "type": "VARCHAR(50)",
                "nullable": true,
                "description": "주문을 식별하는 고유 ID로, 같은 주문에 속한 여러 상품 행을 묶는 기준이 된다."
            },
            {
                "name": "order_item_id",
                "type": "INTEGER",
                "nullable": true,
                "description": "해당 주문 안에서 몇 번째 상품 항목인지 나타내는 순번으로, 동일 주문 내 개별 상품을 구분한다."
            },
            {
                "name": "product_id",
                "type": "VARCHAR(50)",
                "nullable": true,
                "description": "주문된 상품 자체를 식별하는 고유 ID이다."
            },
            {
                "name": "seller_id",
                "type": "VARCHAR(50)",
                "nullable": true,
                "description": "해당 상품을 판매한 판매자(셀러)를 식별하는 ID이다."
            },
            {
                "name": "shipping_limit_date",
                "type": "DATETIME",
                "nullable": true,
                "description": "판매자가 해당 주문 상품을 발송해야 하는 기한 또는 배송 처리 제한 시점이다."
            },
            {
                "name": "price",
                "type": "DECIMAL(10, 2)",
                "nullable": true,
                "description": "상품 1개 또는 해당 주문 항목의 판매 금액을 나타낸다."
            },
            {
                "name": "freight_value",
                "type": "DECIMAL(10, 2)",
                "nullable": true,
                "description": "해당 주문 상품에 대해 부과된 배송비 금액이다."
            }
        ],

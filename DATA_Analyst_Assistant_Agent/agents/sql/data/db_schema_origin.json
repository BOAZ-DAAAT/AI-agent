    "order_payments": {
        "primary_key": [],
        "description": "주문별 결제 정보를 저장하는 테이블로, 한 주문에 대해 결제 수단, 결제 회차, 할부 개수, 결제 금액을 관리한다.",
        "columns": [
            {
                "name": "order_id",
                "type": "VARCHAR(50)",
                "nullable": true,
                "description": "주문을 식별하는 고유 ID로, 어떤 주문의 결제 내역인지 연결해주는 키 역할을 한다."
            },
            {
                "name": "payment_sequential",
                "type": "INTEGER",
                "nullable": true,
                "description": "한 주문에서 결제 항목이 여러 개일 때 각 결제 내역의 순서를 나타내는 번호로 보이며, 샘플에서는 대부분 1로 첫 번째 결제 건임을 의미한다."
            },
            {
                "name": "payment_type",
                "type": "VARCHAR(30)",
                "nullable": true,
                "description": "결제 수단을 나타내는 컬럼으로, 샘플 기준 credit_card(신용카드), boleto(브라질 현금/은행지로 방식) 같은 값이 들어간다."
            },
            {
                "name": "payment_installments",
                "type": "INTEGER",
                "nullable": true,
                "description": "해당 결제가 몇 개의 할부로 나뉘어 처리되었는지를 나타내는 값으로, 1이면 일시불, 2 이상이면 분할 납부를 의미한다."
            },
            {
                "name": "payment_value",
                "type": "DECIMAL(10, 2)",
                "nullable": true,
                "description": "해당 결제 건의 금액을 나타내는 결제액으로, 소수점 둘째 자리까지 저장되는 통화 금액이다."
            }
        ],

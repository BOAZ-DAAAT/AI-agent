    "geolocation": {
        "primary_key": [],
        "description": "이 테이블은 우편번호 접두어(지역 코드)별로 위도·경도, 도시명, 주(state) 정보를 매핑해 둔 지리 위치 참고용 테이블입니다.",
        "columns": [
            {
                "name": "geolocation_zip_code_prefix",
                "type": "VARCHAR(10)",
                "nullable": true,
                "description": "우편번호의 앞자리(접두어)로 보이는 지역 식별 코드입니다. 주문/고객/판매자 주소의 우편번호와 연결하여 해당 지역의 위치 정보를 찾는 데 사용됩니다."
            },
            {
                "name": "geolocation_lat",
                "type": "DOUBLE",
                "nullable": true,
                "description": "해당 우편번호 접두어에 대응하는 위도(latitude) 값입니다. 지도의 남북 위치를 나타내며, 샘플상 브라질 내 여러 도시의 좌표로 보입니다."
            },
            {
                "name": "geolocation_lng",
                "type": "DOUBLE",
                "nullable": true,
                "description": "해당 우편번호 접두어에 대응하는 경도(longitude) 값입니다. 지도의 동서 위치를 나타내며, 위도와 함께 특정 지역의 좌표를 구성합니다."
            },
            {
                "name": "geolocation_city",
                "type": "VARCHAR(100)",
                "nullable": true,
                "description": "해당 우편번호 접두어가 속한 도시명입니다. 샘플에서는 'sao paulo', 'belo horizonte'처럼 브라질 도시명이 저장되어 있습니다."
            },
            {
                "name": "geolocation_state",
                "type": "VARCHAR(5)",
                "nullable": true,
                "description": "해당 도시가 속한 주(state) 약어입니다. 예: SP, RJ, PR, PE, TO, MG 등으로 브라질의 주를 식별합니다."
            }
        ],

{
    "customers": {
        "primary_key": [],
        "description": "이 테이블은 고객의 고유 식별자와 배송지 주소의 지역 정보를 저장해 고객 단위를 구분하고 지역 분석이나 주문 연계에 활용하는 고객 마스터 테이블이다.",
        "columns": [
            {
                "name": "customer_id",
                "type": "VARCHAR(50)",
                "nullable": true,
                "description": "주문 단위로 발급되는 식별자다. 같은 사람이라도 주문할 때마다 새로운 customer_id가 생성되므로 고객이 아니라 사실상 주문 1건에 대응한다(customers와 orders가 customer_id로 1:1 연결). 고객 단위 집계에서는 GROUP BY 대상으로 쓰면 안 되고 orders 조인 키로만 사용한다."
            },
            {
                "name": "customer_unique_id",
                "type": "VARCHAR(50)",
                "nullable": true,
                "description": "동일 인물을 식별하는 실제 고객 키다. 한 사람이 여러 번 주문하면 customer_id는 여러 개 생기지만 customer_unique_id는 동일하다. 재구매·이탈·고객 단위(RFM 등) 분석에서 고객을 묶는 기준(GROUP BY 대상)은 반드시 이 컬럼이어야 한다."
            },
            {
                "name": "customer_zip_code_prefix",
                "type": "VARCHAR(10)",
                "nullable": true,
                "description": "고객 주소의 우편번호 앞자리로, 정확한 전체 주소 대신 지역 단위로 위치를 식별하거나 배송/지역 분석에 활용되는 값이다."
            },
            {
                "name": "customer_city",
                "type": "VARCHAR(100)",
                "nullable": true,
                "description": "고객이 속한 도시명으로, 예시 데이터상 브라질의 도시명이 소문자로 저장되어 있으며 지역 분포 분석에 사용된다."
            },
            {
                "name": "customer_state",
                "type": "VARCHAR(5)",
                "nullable": true,
                "description": "고객이 속한 주(State) 코드로 보이며, 예시에서는 브라질 주 약어(MG, SP, RJ 등)가 저장되어 지역 단위 집계나 배송권역 분석에 활용된다."
            }
        ],
        "foreign_keys": [],

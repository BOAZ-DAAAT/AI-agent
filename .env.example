# MySQL datasource (auto-registered on startup if all set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sql_agent
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DATASOURCE_NAME=default_mysql

# Datamart database
# docker-compose 사용 시: 이 값들이 로컬 MySQL 컨테이너 계정으로 쓰인다.
# DATAMART_DB_HOST 는 compose가 "mysql"로 덮어쓰므로 로컬에선 그대로 둬도 된다.
MYSQL_ROOT_PASSWORD=change_me_root_pw   # compose의 MySQL root 비밀번호
DATAMART_DB_USER=your_datamart_user
DATAMART_DB_PASSWORD=your_datamart_password
DATAMART_DB_HOST=127.0.0.1
DATAMART_DB_PORT=3306
DATAMART_DB_NAME=analytics

# Agent runtime
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=BOAZ DATA Analyst Assistant Agent
LLM_MODEL=~openai/gpt-latest
CHART_READER_MODEL=openai/gpt-5
CODE_GENERATOR_MODEL=openai/gpt-5
ALLOW_MART_WRITE=true

# Optional tuning
MAX_RESULT_ROWS=200
MAX_RESULT_PREVIEW_ROWS=20

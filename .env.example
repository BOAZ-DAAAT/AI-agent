# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=DAAAT

# MySQL datasource used by SQL/EDA/Analysis agents
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sql_agent
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Legacy DB aliases (optional; MYSQL_* is preferred)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sql_agent
DB_USER=root
DB_PASSWORD=

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=BOAZ DATA Analyst Assistant Agent

# Alternative model providers (optional)
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Agent models
LLM_MODEL=~openai/gpt-latest
CHART_READER_MODEL=openai/gpt-5
CODE_GENERATOR_MODEL=openai/gpt-5
ANALYSIS_CRITIC_MODEL=openai/gpt-5
INSIGHT_MODEL=

# SQL agent runtime
MAX_RETRIES=2
ALLOW_MART_WRITE=true
ALLOWED_MART_SCHEMA=analytics

# Datamart / docker-compose database
MYSQL_ROOT_PASSWORD=change_me_root_pw
DATAMART_DB_HOST=127.0.0.1
DATAMART_DB_PORT=3306
DATAMART_DB_NAME=analytics
DATAMART_DB_USER=root
DATAMART_DB_PASSWORD=

# Backend service
CORS_ALLOW_ORIGINS=*
PUBLIC_API_BASE_URL=http://localhost:8000
STORAGE_MYSQL_HOST=127.0.0.1
STORAGE_MYSQL_PORT=3306
STORAGE_MYSQL_USER=root
STORAGE_MYSQL_PASSWORD=
INGEST_ROW_LIMIT=1000000
INGEST_CHUNK_SIZE=10000

# Optional tuning
MAX_RESULT_ROWS=200
MAX_RESULT_PREVIEW_ROWS=20
INSIGHT_CHART_DIR=
RUN_REAL_LLM=
